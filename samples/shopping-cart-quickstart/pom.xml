<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.akka</groupId>
    <artifactId>akka-javasdk-parent</artifactId>
    <version>3.5.18</version>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>shopping-cart-quickstart</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>shopping-cart-quickstart</name>

  <build>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.10.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>io.akka</groupId>
        <artifactId>akka-runtime-dev-maven-plugin</artifactId>
        <version>1.6.0-7-d47f8ba2-dev-SNAPSHOT</version>
        <executions>
          <execution>
            <goals>
              <goal>exportRuntimeClasspath</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <excludeArtifactIds>akka-runtime-dev_2.13</excludeArtifactIds>
          <outputProperty>dependencies.output</outputProperty>
          <outputFile>${project.build.directory}/dependencies.txt</outputFile>
        </configuration>
        <executions>
          <execution>
            <id>render-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>render-dependencies</goal>
            </goals>
            <configuration>
              <outputType>text</outputType>
              <includeScope>compile</includeScope>
              <excludeArtifactsIds>akka-runtime-dev_2.13</excludeArtifactsIds>
              <template>
                #foreach($a in $artifacts)
${a.groupId}:${a.artifactId}:${a.version}|${a.scope}|${a.file.name}|${a.dependencyTrail}
                #end'
              </template>
              <verbose>true</verbose>
            </configuration>
          </execution>
          <execution>
            <id>render-dependencies1</id>
            <phase>validate</phase>
            <goals>
              <goal>render-dependencies</goal>
            </goals>
            <configuration>
              <outputType>text</outputType>
              <includeScope>compile</includeScope>
              <graphRoot></graphRoot>
              <excludeArtifactsIds>akka-runtime-dev_2.13</excludeArtifactsIds>
              <template>
                #foreach($a in $artifacts)
${a.groupId}:${a.artifactId}:${a.version}|${a.scope}|${a.file.name}|${a.dependencyTrail}
                #end'
              </template>
              <verbose>true</verbose>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
